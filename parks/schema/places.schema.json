{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avifauna-ontdekker.local/schema/places.schema.json",
  "title": "places.geojson (WGS84, [lon, lat])",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "name": { "type": "string" },
    "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "type": "number" },
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ]
    },
    "ring": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/position" } },
    "point": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": { "type": { "const": "Point" }, "coordinates": { "$ref": "#/$defs/position" } }
    },
    "polygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ring" } }
      }
    },
    "multipolygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "MultiPolygon" },
        "coordinates": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ring" } } }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "properties": {
      "type": "object",
      "required": ["id", "kind", "name_nl", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["zone", "enclosure", "facility", "anchor"] },
        "name_nl": { "type": "string", "minLength": 1 },
        "name_en": { "type": "string", "minLength": 1 },
        "zone_id": { "$ref": "#/$defs/id" },
        "facility_type": { "enum": ["toilet", "baby_change", "food", "water", "playground", "picnic", "show", "feeding", "entrance", "exit", "first_aid", "info", "shelter"] },
        "indoor": { "type": "boolean" },
        "source": { "enum": ["veldwerk", "osm", "manual"] },
        "last_seen": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" }
      },
      "if": { "properties": { "kind": { "const": "facility" } }, "required": ["kind"] },
      "then": { "required": ["facility_type"] },
      "else": { "not": { "required": ["facility_type"] } }
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "properties": { "$ref": "#/$defs/properties" },
        "geometry": { "oneOf": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/polygon" }, { "$ref": "#/$defs/multipolygon" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "properties": { "properties": { "kind": { "const": "zone" } }, "required": ["kind"] } }, "required": ["properties"] },
          "then": { "properties": { "geometry": { "oneOf": [{ "$ref": "#/$defs/polygon" }, { "$ref": "#/$defs/multipolygon" }] } } }
        },
        {
          "if": { "properties": { "properties": { "properties": { "kind": { "enum": ["facility", "anchor"] } }, "required": ["kind"] } }, "required": ["properties"] },
          "then": { "properties": { "geometry": { "$ref": "#/$defs/point" } } }
        },
        {
          "if": { "properties": { "properties": { "properties": { "kind": { "const": "enclosure" } }, "required": ["kind"] } }, "required": ["properties"] },
          "then": { "properties": { "geometry": { "oneOf": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/polygon" }] } } }
        }
      ]
    }
  }
}
