{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avifauna-ontdekker.local/schema/facts.schema.json",
  "title": "facts/<slug>.yaml (spiegel van Facts in src/data/types.ts)",
  "description": "Zelf verzamelde feiten met bronnen. Ranges zijn [min, max] met min <= max (bij één bekende waarde min = max). Onbekend = null of [].",
  "type": "object",
  "required": ["slug", "reviewed", "is_bird", "sources"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z]+-[a-z][a-z-]*$" },
    "reviewed": { "type": "boolean" },
    "is_bird": { "type": "boolean" },
    "length_cm": { "$ref": "#/$defs/range" },
    "height_cm": { "$ref": "#/$defs/range" },
    "mass_g": { "$ref": "#/$defs/range" },
    "wingspan_cm": { "$ref": "#/$defs/range" },
    "lifespan_wild_y": { "$ref": "#/$defs/range" },
    "lifespan_captivity_y": { "$ref": "#/$defs/range" },
    "clutch": { "$ref": "#/$defs/l10n" },
    "incubation_days": { "$ref": "#/$defs/range" },
    "continents": {
      "type": ["array", "null"],
      "uniqueItems": true,
      "items": { "enum": ["africa", "asia", "europe", "north-america", "south-america", "oceania", "antarctica"] }
    },
    "range": { "$ref": "#/$defs/l10n" },
    "range_center": {
      "type": ["object", "null"],
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "habitat": { "$ref": "#/$defs/l10n" },
    "diet": { "$ref": "#/$defs/l10n" },
    "colors": {
      "type": ["array", "null"],
      "uniqueItems": true,
      "items": { "enum": ["black", "white", "grey", "brown", "red", "orange", "yellow", "green", "blue", "purple", "pink"] }
    },
    "iucn_trend": { "enum": ["decreasing", "stable", "increasing", "unknown", null] },
    "threats": { "$ref": "#/$defs/l10n" },
    "wow": { "$ref": "#/$defs/l10n" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": ["array", "null"],
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": 0 }
    },
    "l10n": {
      "type": ["object", "null"],
      "required": ["nl"],
      "additionalProperties": false,
      "properties": {
        "nl": { "type": "string", "minLength": 1 },
        "en": { "type": ["string", "null"] }
      }
    }
  }
}
