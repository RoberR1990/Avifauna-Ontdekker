{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avifauna-ontdekker.local/schema/text-frontmatter.schema.json",
  "title": "Frontmatter van texts/<taal>/<slug>.md (secties: ## kind, ## b1, optioneel ## kenner)",
  "type": "object",
  "required": ["slug", "lang", "sources", "reviewed"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z]+-[a-z][a-z-]*$" },
    "lang": { "type": "string", "pattern": "^[a-z]{2}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": { "title": { "type": "string", "minLength": 1 }, "url": { "type": "string", "format": "uri" } }
      }
    },
    "reviewed": { "type": "boolean" },
    "reviewed_by": { "type": "string", "minLength": 1 },
    "reviewed_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" }
  }
}
