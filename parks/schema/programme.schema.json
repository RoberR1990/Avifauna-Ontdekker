{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avifauna-ontdekker.local/schema/programme.schema.json",
  "title": "programme.json (dagprogramma, handmatig bijgehouden)",
  "type": "object",
  "required": ["last_checked", "source_url", "items"],
  "additionalProperties": false,
  "properties": {
    "last_checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
    "source_url": { "type": "string", "format": "uri" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "mmdd": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "localized": {
      "type": "object",
      "required": ["nl"],
      "additionalProperties": false,
      "properties": { "nl": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "item": {
      "type": "object",
      "required": ["time", "title"],
      "additionalProperties": false,
      "properties": {
        "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "days": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] } },
        "season": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": { "from": { "$ref": "#/$defs/mmdd" }, "to": { "$ref": "#/$defs/mmdd" } }
        },
        "title": { "$ref": "#/$defs/localized" },
        "place_id": { "$ref": "#/$defs/id" },
        "species": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+-[a-z][a-z-]*$" } },
        "note": { "$ref": "#/$defs/localized" }
      }
    }
  }
}
