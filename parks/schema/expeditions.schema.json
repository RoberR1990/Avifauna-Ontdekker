{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avifauna-ontdekker.local/schema/expeditions.schema.json",
  "title": "expeditions.yaml (na het parsen)",
  "description": "Taakregels: choose heeft options (>=2) en answer = 0-gebaseerde index in options; count heeft een geheel getal als answer; find en look hebben geen answer; answer = tekst of getal.",
  "type": "object",
  "required": ["expeditions"],
  "additionalProperties": false,
  "properties": {
    "expeditions": { "type": "array", "items": { "$ref": "#/$defs/expedition" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "mmdd": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "localized": {
      "type": "object",
      "required": ["nl"],
      "additionalProperties": false,
      "properties": { "nl": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "season": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": { "from": { "$ref": "#/$defs/mmdd" }, "to": { "$ref": "#/$defs/mmdd" } }
    },
    "expedition": {
      "type": "object",
      "required": ["id", "title", "intro", "badge", "stops"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/localized" },
        "intro": { "$ref": "#/$defs/localized" },
        "season": { "$ref": "#/$defs/season" },
        "badge": {
          "type": "object",
          "required": ["id", "name", "icon"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/localized" },
            "icon": { "type": "string", "minLength": 1 }
          }
        },
        "stops": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stop" } }
      }
    },
    "stop": {
      "type": "object",
      "required": ["id", "zone_id", "task"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "zone_id": { "$ref": "#/$defs/id" },
        "place_id": { "$ref": "#/$defs/id" },
        "species": { "type": "string", "pattern": "^[a-z]+-[a-z][a-z-]*$" },
        "task": { "$ref": "#/$defs/task" },
        "indoor": { "type": "boolean" }
      }
    },
    "task": {
      "type": "object",
      "required": ["type", "prompt"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["find", "count", "look", "answer", "choose"] },
        "prompt": { "$ref": "#/$defs/localized" },
        "answer": { "type": ["string", "number"] },
        "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/localized" } },
        "hint": { "$ref": "#/$defs/localized" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "choose" } }, "required": ["type"] },
          "then": { "required": ["options"], "properties": { "answer": { "type": "integer", "minimum": 0 } } },
          "else": { "not": { "required": ["options"] } }
        },
        {
          "if": { "properties": { "type": { "const": "count" } }, "required": ["type"] },
          "then": { "properties": { "answer": { "type": "integer", "minimum": 0 } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["find", "look"] } }, "required": ["type"] },
          "then": { "not": { "required": ["answer"] } }
        }
      ]
    }
  }
}
