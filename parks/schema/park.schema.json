{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avifauna-ontdekker.local/schema/park.schema.json",
  "title": "park.json",
  "description": "Metadata van een parkpakket. map_georef: pad (relatief aan de parkmap) naar het georef-bestand van de kaart, bv. \"map/georef.json\", of null. Gekozen voor verwijzing op pad zodat de ijkpunten in een eigen bestand bij de kaart blijven.",
  "type": "object",
  "required": ["id", "app_name", "park_name", "languages", "default_language", "disclaimer_bar", "footer", "about", "links", "theme"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "app_name": { "type": "string", "minLength": 1 },
    "park_name": { "type": "string", "minLength": 1 },
    "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/lang" } },
    "default_language": { "$ref": "#/$defs/lang" },
    "disclaimer_bar": { "$ref": "#/$defs/localized" },
    "footer": { "$ref": "#/$defs/localized" },
    "about": {
      "type": "object",
      "required": ["builder", "nl"],
      "additionalProperties": false,
      "properties": {
        "builder": { "type": "string", "minLength": 1 },
        "nl": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "source_code_url": { "type": ["string", "null"], "format": "uri" },
        "personal_site_url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "links": {
      "type": "object",
      "required": ["official_site"],
      "additionalProperties": false,
      "properties": {
        "official_site": { "type": "string", "format": "uri" },
        "tickets": { "type": ["string", "null"], "format": "uri" },
        "programme": { "type": ["string", "null"], "format": "uri" },
        "map": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "theme": {
      "type": "object",
      "required": ["primary", "background", "text"],
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/hex" },
        "background": { "$ref": "#/$defs/hex" },
        "text": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" },
        "surface": { "$ref": "#/$defs/hex" },
        "muted": { "$ref": "#/$defs/hex" }
      }
    },
    "center": {
      "description": "Optioneel: kaartmidden (WGS84).",
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "map_georef": { "type": ["string", "null"], "minLength": 1 },
    "noindex": { "type": "boolean" }
  },
  "$defs": {
    "lang": { "type": "string", "pattern": "^[a-z]{2}$" },
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "localized": {
      "type": "object",
      "required": ["nl"],
      "additionalProperties": { "type": "string", "minLength": 1 },
      "propertyNames": { "pattern": "^[a-z]{2}$" }
    }
  }
}
